using std;

/** Verifies visual reduction against all original samples, including sharp wave fronts. */
public module charts {

  /** Produces either a sharp pulse or a smooth wave as an independent reference. */
  function reference(index: i64, pulse: bool) f64 {
    if (pulse) {
      return index >= 251 and index <= 619 ? 1.0 : 0.0;
    }
    return tline.sine(_convert<f64>(index) * 0.006283185307179586);
  }

  /** Checks every original point against the simplified curve and preserves endpoints. */
  function verify(pulse: bool) void throws {
    var series = plot.Series(
      String("Reference"),
      String("blue"),
      false
    );
    for (var i: i64 = 0; i <= 1000; i += 1) {
      series.add(_convert<f64>(i), reference(i, pulse));
    }
    simplify(series, 0.001);
    std.test.assert(series.points.size() < 500);
    std.test.assert_eq(series.points[0].x, 0.0);
    std.test.assert_eq(series.points[series.points.size() - 1].x, 1000.0);
    var segment: i64 = 0;
    for (var i: i64 = 0; i <= 1000; i += 1) {
      var x = _convert<f64>(i);
      while (segment + 2 < series.points.size() and series.points[segment + 1].x < x) {
        segment += 1;
      }
      var fraction = (x - series.points[segment].x) /
        (series.points[segment + 1].x - series.points[segment].x);
      var y = series.points[segment].y +
        fraction * (series.points[segment + 1].y - series.points[segment].y);
      std.test.assert(tline.absolute(y - reference(i, pulse)) <= 0.001000001);
    }
    return;
  }

  /** Keeps a sine wave within the requested visual error after reducing SVG work. */
  test_function smooth_curve_accuracy() {
    return verify(false);
  }

  /** Preserves the height and position of a sharp pulse's leading and trailing fronts. */
  test_function sharp_front_accuracy() {
    return verify(true);
  }
}
