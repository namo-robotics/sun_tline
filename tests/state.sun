using std;

/** Exercises application behavior without a graphical dependency. */
module state_tests {

  /** Propagates assertions and simulation construction failures. */
  enum TestResult<T> { Ok(T), Assertion(std.test.AssertionError), System(Error) }

  /** Checks pausing, speed-independent physics, and reset semantics. */
  test_function playback() TestResult<void> {
    var a = try app.State();
    var b = try app.State();
    a.tick(0.1);
    try std.test.assert_eq(a.simulation.steps, 0);
    a.running = true;
    b.running = true;
    b.speed = 2.0;
    for (var i: i64 = 0; i < 64; i += 1) {
      a.tick(0.03125);
      b.tick(0.015625);
    }
    try std.test.assert_eq(a.simulation.steps, b.simulation.steps);
    for (var i: i64 = 0; i <= 512; i += 1) {
      try std.test.assert_eq(a.simulation.voltage(i), b.simulation.voltage(i));
    }
    a.reset();
    try std.test.assert_eq(a.simulation.steps, 0);
    try std.test.assert(not a.running);
    return TestResult.Ok;
  }

  /** Fractional playback moves the visible wave while keeping numerical steps deterministic. */
  test_function fractional_wave_motion() TestResult<void> {
    var s = try app.State();
    s.running = true;
    var initial = s.simulation.plus(0);
    s.tick(0.5 / 512.0);
    try std.test.assert_eq(s.simulation.steps, 0);
    try std.test.assert_eq(s.simulation.plus(1), 0.0);
    try std.test.assert(tline.absolute(s.display_plus(1) - initial * 0.5) < 1e-12);
    var frozen = s.display_plus(1);
    s.running = false;
    s.tick(1.0);
    try std.test.assert_eq(s.display_plus(1), frozen);
    s.running = true;
    s.tick(0.5 / 512.0);
    try std.test.assert_eq(s.simulation.steps, 1);
    try std.test.assert_eq(s.display_plus(1), initial);
    s.reset();
    try std.test.assert_eq(s.credit, 0.0);
    try s.preset(3);
    s.advance(511);
    s.credit = 0.5;
    try std.test.assert_eq(s.display_plus(512) + s.display_minus(512), 0.0);
    return TestResult.Ok;
  }

  /** Reserves both polarities of twice the source amplitude so reflected voltage remains visible. */
  test_function reflection_voltage_limits() TestResult<void> {
    var s = try app.State();
    try std.test.assert_eq(s.voltage_scale, 2.0);
    ignore_error(s.fields.set(0, String("3")));
    s.apply();
    try std.test.assert_eq(s.voltage_scale, 6.0);
    s.rescale();
    try std.test.assert_eq(s.voltage_scale, 6.0);
    ignore_error(s.fields.set(0, String("-2")));
    s.apply();
    try std.test.assert_eq(s.voltage_scale, 4.0);
    return TestResult.Ok;
  }

  /** Sine-pulse settings expose duration, retain their mode on reset, and ignore continuous-sine frequency. */
  test_function sine_pulse_settings() TestResult<void> {
    var s = try app.State();
    s.wave_index = 3;
    try std.test.assert(s.field_visible(8));
    try std.test.assert(not s.field_visible(9));
    ignore_error(s.fields.set(9, String("unused")));
    s.apply();
    try std.test.assert(s.simulation.config.wave == tline.Wave.SinePulse);
    s.advance(256);
    s.reset();
    try std.test.assert_eq(s.wave_index, 3);
    try std.test.assert_eq(s.simulation.steps, 0);
    try std.test.assert(s.simulation.config.wave == tline.Wave.SinePulse);
    return TestResult.Ok;
  }

  /** Removes binary floating-point tails and keeps a consistent precision across time units. */
  test_function stable_time_readout() TestResult<void> {
    try std.test.assert(app.time_label(301.26953124999994e-9).equals_literal("301.270 ns"));
    try std.test.assert(app.time_label(50e-9).equals_literal("50.000 ns"));
    try std.test.assert(app.time_label(0.0).equals_literal("0.000 ns"));
    try std.test.assert(app.time_label(12.5e-6).equals_literal("12.500 us"));
    try std.test.assert(app.time_label(12.5e-3).equals_literal("12.500 ms"));
    try std.test.assert(app.time_label(1.25).equals_literal("1.250 s"));
    return TestResult.Ok;
  }

  /** Invalid drafts leave the existing circuit and time untouched. */
  test_function atomic_settings() TestResult<void> {
    var s = try app.State();
    s.advance(50);
    ignore_error(s.fields.set(2, String("invalid")));
    s.apply();
    try std.test.assert_eq(s.simulation.steps, 50);
    try std.test.assert_eq(s.simulation.config.z, 50.0);
    ignore_error(s.fields.set(2, String("75")));
    s.apply();
    try std.test.assert_eq(s.simulation.steps, 0);
    try std.test.assert_eq(s.simulation.config.z, 75.0);
    return TestResult.Ok;
  }

  /** An invalid hidden component field cannot block an unrelated circuit. */
  test_function inactive_fields() TestResult<void> {
    var s = try app.State();
    ignore_error(s.fields.set(6, String("invalid capacitor")));
    s.apply();
    try std.test.assert_eq(s.simulation.config.z, 50.0);
    s.load_index = 3;
    s.advance(10);
    s.apply();
    try std.test.assert_eq(s.simulation.steps, 10);
    return TestResult.Ok;
  }

  /** History wraps chronologically without growing; display changes preserve time. */
  test_function history_and_presets() TestResult<void> {
    var s = try app.State();
    s.advance(512 * 40);
    try std.test.assert_eq(s.history.size(), 2048);
    var first = s.history[s.history_index(0)].time;
    var last = s.history[s.history_index(2047)].time;
    try std.test.assert(first > 0.0 and last > first);
    var steps = s.simulation.steps;
    s.components = true;
    s.rescale();
    try std.test.assert_eq(s.simulation.steps, steps);
    for (var i: i64 = 0; i < 8; i += 1) {
      try s.preset(i);
      try std.test.assert_eq(s.simulation.steps, 0);
    }
    return TestResult.Ok;
  }
}
