using std;

/** Exercises application behavior without a graphical dependency. */
module state_tests {

  /** Checks pausing, speed-independent physics, and reset semantics. */
  test_function playback() {
    var a = app.State();
    var b = app.State();
    a.tick(0.1);
    std.test.assert_eq(a.simulation.steps, 0);
    a.running = true;
    b.running = true;
    b.speed = 2.0;
    for (var i: i64 = 0; i < 64; i += 1) {
      a.tick(0.03125);
      b.tick(0.015625);
    }
    std.test.assert_eq(a.simulation.steps, b.simulation.steps);
    for (var i: i64 = 0; i <= 512; i += 1) {
      std.test.assert_eq(a.simulation.voltage(i), b.simulation.voltage(i));
    }
    a.reset();
    std.test.assert_eq(a.simulation.steps, 0);
    std.test.assert(not a.running);
    return;
  }

  /** Delayed frames retain wall time and catch up through bounded batches at maximum settings. */
  test_function delayed_playback() {
    var s = app.State();
    var c = tline.Config();
    c.cells = 16384;
    s.install(c);
    s.running = true;
    s.speed = 8.0;
    s.tick(0.25);
    std.test.assert_eq(s.simulation.steps, 4096);
    std.test.assert_eq(s.credit, 28672.0);
    // A backlog must not extrapolate a fractional wave beyond adjacent cells.
    std.test.assert_eq(s.display_plus(4097), s.simulation.plus(4097));
    for (var i: i64 = 0; i < 7; i += 1) {
      s.tick(0.0);
    }
    std.test.assert_eq(s.simulation.steps, 32768);
    std.test.assert_eq(s.credit, 0.0);
    for (var i: i64 = 0; i < 240; i += 1) {
      s.tick(1.0 / 240.0);
    }
    std.test.assert(
      tline.absolute(_convert<f64>(s.simulation.steps) + s.credit - 163840.0) < 1e-6
    );
    return;
  }

  /** Fractional playback moves the visible wave while keeping numerical steps deterministic. */
  test_function fractional_wave_motion() {
    var s = app.State();
    s.running = true;
    var initial = s.simulation.plus(0);
    s.tick(0.5 / 512.0);
    std.test.assert_eq(s.simulation.steps, 0);
    std.test.assert_eq(s.simulation.plus(1), 0.0);
    std.test.assert(tline.absolute(s.display_plus(1) - initial * 0.5) < 1e-12);
    var frozen = s.display_plus(1);
    s.running = false;
    s.tick(1.0);
    std.test.assert_eq(s.display_plus(1), frozen);
    s.running = true;
    s.tick(0.5 / 512.0);
    std.test.assert_eq(s.simulation.steps, 1);
    std.test.assert_eq(s.display_plus(1), initial);
    s.reset();
    std.test.assert_eq(s.credit, 0.0);
    s.preset(3);
    s.advance(511);
    s.credit = 0.5;
    std.test.assert_eq(s.display_plus(512) + s.display_minus(512), 0.0);
    return;
  }

  /** Reserves both polarities of twice the source amplitude so reflected voltage remains visible. */
  test_function reflection_voltage_limits() {
    var s = app.State();
    std.test.assert_eq(s.voltage_scale, 2.0);
    try {
      s.fields.set(0, String("3"));
    } catch {}
    s.apply();
    std.test.assert_eq(s.voltage_scale, 6.0);
    s.rescale();
    std.test.assert_eq(s.voltage_scale, 6.0);
    try {
      s.fields.set(0, String("-2"));
    } catch {}
    s.apply();
    std.test.assert_eq(s.voltage_scale, 4.0);
    return;
  }

  /** Sine-pulse settings expose duration, retain their mode on reset, and ignore continuous-sine frequency. */
  test_function sine_pulse_settings() {
    var s = app.State();
    s.wave_index = 3;
    std.test.assert(s.field_visible(8));
    std.test.assert(not s.field_visible(9));
    try {
      s.fields.set(9, String("unused"));
    } catch {}
    s.apply();
    std.test.assert(s.simulation.config.wave == tline.Wave.SinePulse);
    s.advance(256);
    s.reset();
    std.test.assert_eq(s.wave_index, 3);
    std.test.assert_eq(s.simulation.steps, 0);
    std.test.assert(s.simulation.config.wave == tline.Wave.SinePulse);
    return;
  }

  /** Removes binary floating-point tails and keeps a consistent precision across time units. */
  test_function stable_time_readout() {
    std.test.assert((app.time_label(301.26953124999994e-9)).equals_literal("301.270 ns"));
    std.test.assert((app.time_label(50e-9)).equals_literal("50.000 ns"));
    std.test.assert((app.time_label(0.0)).equals_literal("0.000 ns"));
    std.test.assert((app.time_label(12.5e-6)).equals_literal("12.500 us"));
    std.test.assert((app.time_label(12.5e-3)).equals_literal("12.500 ms"));
    std.test.assert((app.time_label(1.25)).equals_literal("1.250 s"));
    return;
  }

  /** Invalid drafts leave the existing circuit and time untouched. */
  test_function atomic_settings() {
    var s = app.State();
    s.advance(50);
    try {
      s.fields.set(2, String("invalid"));
    } catch {}
    s.apply();
    std.test.assert_eq(s.simulation.steps, 50);
    std.test.assert_eq(s.simulation.config.z, 50.0);
    try {
      s.fields.set(2, String("75"));
    } catch {}
    s.apply();
    std.test.assert_eq(s.simulation.steps, 0);
    std.test.assert_eq(s.simulation.config.z, 75.0);
    return;
  }

  /** An invalid hidden component field cannot block an unrelated circuit. */
  test_function inactive_fields() {
    var s = app.State();
    try {
      s.fields.set(6, String("invalid capacitor"));
    } catch {}
    s.apply();
    std.test.assert_eq(s.simulation.config.z, 50.0);
    s.load_index = 3;
    s.advance(10);
    s.apply();
    std.test.assert_eq(s.simulation.steps, 10);
    return;
  }

  /** History wraps chronologically without growing; display changes preserve time. */
  test_function history_and_presets() {
    var s = app.State();
    s.advance(512 * 40);
    std.test.assert_eq(s.history.size(), 2048);
    var first = s.history[s.history_index(0)].time;
    var last = s.history[s.history_index(2047)].time;
    std.test.assert(first > 0.0 and last > first);
    var steps = s.simulation.steps;
    s.components = true;
    s.rescale();
    std.test.assert_eq(s.simulation.steps, steps);
    for (var i: i64 = 0; i < 8; i += 1) {
      s.preset(i);
      std.test.assert_eq(s.simulation.steps, 0);
    }
    return;
  }
}
