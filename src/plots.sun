using std;

/** Converts simulation snapshots into vector plots without owning native resources. */
public module charts {

  /** Removes visually redundant samples while bounding vertical error at every original sample. */
  function simplify(series: ref plot.Series, tolerance: f64) void throws {
    if (series.points.size() < 3) {
      return;
    }
    var a = make_heap_allocator();
    var reduced = Vec<plot.Point>(a, series.points.size());
    var anchor: i64 = 0;
    var lower: f64 = -1e300;
    var upper: f64 = 1e300;
    reduced.push(plot.Point(series.points[0].x, series.points[0].y));
    for (var index: i64 = 1; index < series.points.size(); index += 1) {
      var dx = series.points[index].x - series.points[anchor].x;
      var dy = series.points[index].y - series.points[anchor].y;
      if (dx <= 0.0) {
        continue;
      }
      var slope = dy / dx;
      if (slope < lower or slope > upper) {
        anchor = index - 1;
        reduced.push(plot.Point(series.points[anchor].x, series.points[anchor].y));

        lower = -1e300;
        upper = 1e300;
        dx = series.points[index].x - series.points[anchor].x;
        dy = series.points[index].y - series.points[anchor].y;
      }
      if (dx > 0.0) {
        var low = (dy - tolerance) / dx;
        var high = (dy + tolerance) / dx;
        if (low > lower) {
          lower = low;
        }
        if (high < upper) {
          upper = high;
        }
      }
    }
    var end = series.points.size() - 1;
    reduced.push(plot.Point(series.points[end].x, series.points[end].y));

    series.points = reduced;

    return;
  }

  /** Builds a spatial voltage or current plot with optional traveling components. */
  function spatial(state: const ref app.State, current: bool) ui_drawing.Drawing throws {
    var f = plot.Figure(
      String(current ? "Current along the line" : "Voltage along the line"),
      String("Distance (m)"),
      String(current ? "Current (A)" : "Voltage (V)")
    );
    var total = plot.Series(
      String("Total"),
      String(current ? "#49df9b" : "#ff646e"),
      false
    );
    var plus = plot.Series(
      String("Toward load"),
      String(current ? "#b2f1ca" : "#ffb0b6"),
      false
    );
    var minus = plot.Series(
      String("Toward source"),
      String(current ? "#239e70" : "#ca4058"),
      false
    );
    total.line_width = 2.6;
    plus.line_width = 1.5;
    minus.line_width = 1.5;
    var cells = state.simulation.config.cells;
    var stride = cells / 512;
    if (stride < 1) {
      stride = 1;
    }
    for (var i: i64 = 0; i <= cells; i += stride) {
      var x = _convert<f64>(i) * state.simulation.config.length / _convert<f64>(cells);
      var p = state.display_plus(i);
      var m = state.display_minus(i);
      if (current) {
        p /= state.simulation.config.z;
        m /= -state.simulation.config.z;
      }
      total.add(x, p + m);
      plus.add(x, p);
      minus.add(x, m);
    }
    // Include the exact load boundary even when display decimation does not divide the grid.
    if (cells % stride != 0) {
      var p = state.display_plus(cells);
      var m = state.display_minus(cells);
      if (current) {
        p /= state.simulation.config.z;
        m /= -state.simulation.config.z;
      }
      total.add(state.simulation.config.length, p + m);
      plus.add(state.simulation.config.length, p);
      minus.add(state.simulation.config.length, m);
    }
    var tolerance = (current ? state.current_scale : state.voltage_scale) * 0.001;
    simplify(total, tolerance);
    simplify(plus, tolerance);
    simplify(minus, tolerance);
    f.add(total);
    if (state.components) {
      f.add(plus);
      f.add(minus);
    }
    var scale = current ? state.current_scale : state.voltage_scale;
    f.x_limits = Option.Some(plot.Limits(0.0, state.simulation.config.length));
    f.y_limits = Option.Some(plot.Limits(-scale, scale));
    return f.draw(1090.0, 300.0);
  }

  /** Applies the application palette to the toolkit's fixed SVG chrome for display and export alike. */
  public function document(state: const ref app.State) String throws {
    var drawing = draw(state);
    var content = drawing.svg();
    // Match only complete paint attributes; waveform colors and user labels are untouched.
    content.replace("fill=\"white\"", "fill=\"#0b1220\"");
    content.replace("fill=\"#202735\"", "fill=\"#dce6f4\"");
    content.replace("stroke=\"#343d4d\"", "stroke=\"#65748b\"");
    content.replace("stroke=\"#e1e5eb\"", "stroke=\"#243145\"");
    return content;
  }

  /** Draws the source, two-conductor line, load, and two synchronized wave plots. */
  public function draw(state: const ref app.State) ui_drawing.Drawing throws {
    var d = ui_drawing.Drawing(1100.0, 750.0);
    var ink = String("#91a3bc");
    d.text(
      30.0,
      32.0,
      String("SUN TLINE  /  Lossless transmission line"),
      23.0,
      false,
      0.0
    );
    d.circle(65.0, 92.0, 22.0, String("#23334b"));
    d.text(65.0, 97.0, String("Vs"), 16.0, true, 0.0);
    d.line(65.0, 70.0, 985.0, 70.0, ink, 2.0);
    d.line(65.0, 114.0, 985.0, 114.0, ink, 2.0);
    d.line(65.0, 70.0, 65.0, 76.0, ink, 2.0);
    d.line(65.0, 108.0, 65.0, 114.0, ink, 2.0);
    d.text(
      180.0,
      61.0,
      `Rs = ${state.simulation.config.source_r} ohm`,
      14.0,
      true,
      0.0
    );
    d.text(
      510.0,
      61.0,
      `Z0 = ${state.simulation.config.z} ohm; length = ${state.simulation.config.length} m`,
      14.0,
      true,
      0.0
    );
    d.text(
      510.0,
      97.0,
      String("incident  →                       ←  reflected"),
      16.0,
      true,
      0.0
    );
    if (state.active_load != 0) {
      d.line(985.0, 70.0, 985.0, 114.0, String("#73e2cb"), 5.0);
    }
    d.text(900.0, 136.0, app.load_name(state.active_load), 14.0, true, 0.0);
    var v = spatial(state, false);
    var i = spatial(state, true);
    d.place(5.0, 150.0, v);
    d.place(5.0, 450.0, i);
    return d;
  }
}
