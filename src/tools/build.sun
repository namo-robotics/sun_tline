using std;

/** Builds named products with explicitly selected, independently published dependencies. */
module build_tasks {

  /** Copies an environment override or a repository-relative default. */
  function setting(name: static_ptr<u8>, fallback: static_ptr<u8>) String {
    var a = make_heap_allocator();
    var env = std.env.Env(a);
    return match env.get(name) {
      Option.Some(value) => value.clone(a),
      Option.None => String(fallback)
    };
  }

  /** Runs a child command and propagates its failure status. */
  function run(command: ref std.process.Command) SystemResult<void> {
    var status = try command.status();
    if (status != 0) {
      return SystemResult.Error(Error(status, "Build or validation command failed"));
    }
    return SystemResult.Ok;
  }

  /** Compiles a configured application or headless test target. */
  function compile(name: static_ptr<u8>, native: bool) SystemResult<void> {
    var a = make_heap_allocator();
    var target = try build_targets.load(name);
    var command = std.process.Command(a, setting("SUN_EXECUTABLE", "sun"));
    command.add_arg("--dynamic");
    command.add_arg("--force-rebuild");
    command.add_arg("-c");
    command.add_arg("-o");
    command.add_arg(target.output);
    if (String(name).equals_literal("plot-tests")) {
      command.add_arg("--lib-path");
      command.add_arg(setting("SUN_UI_BUILD", "build/dependencies/sun_ui/build"));
    }
    if (native) {
      var ui_path = setting("SUN_UI_BUILD", "build/dependencies/sun_ui/build");
      var gtk_path = setting("SUN_GOBJECT_BUILD", "build/dependencies/sun_gobject/build");
      command.add_arg("--lib-path");
      command.add_arg(ui_path);
      command.add_arg("--lib-path");
      command.add_arg(gtk_path);
      command.add_arg(`-L${gtk_path}/native`);
      command.add_arg("-lsun_gobject_native");
      command.add_arg("-lm");
      var pkg = std.process.Command(a, "pkg-config");
      pkg.add_arg("--libs");
      pkg.add_arg("gtk4");
      var uname = std.process.Command(a, "uname");
      uname.add_arg("-s");
      var platform = try uname.output();
      var darwin = platform.stdout().starts_with("Darwin");
      if (darwin) {
        pkg.add_arg("librsvg-2.0");
      }
      var output = try pkg.output();
      if (output.status() != 0) {
        return SystemResult.Error(Error(1, "Install GTK4 and librsvg development libraries."));
      }
      var flags = output.stdout().split_whitespace(a);
      for (var flag: ref String in flags) {
        command.add_arg(flag);
      }
      if (not darwin) {
        command.add_arg("-l:librsvg-2.so.2");
      }
    }
    command.add_arg(target.source);
    return run(command);
  }

  /** Runs headless tests from the configured output. */
  function test(name: static_ptr<u8>) SystemResult<void> {
    try compile(name, false);
    var a = make_heap_allocator();
    var target = try build_targets.load(name);
    var command = std.process.Command(a, target.tests);
    return run(command);
  }

  /** Selects a build, test, or native acceptance operation. */
  public function execute(mode: ref String) SystemResult<void> {
    var a = make_heap_allocator();
    var mkdir = std.process.Command(a, "mkdir");
    mkdir.add_arg("-p");
    mkdir.add_arg("build");
    try run(mkdir);
    var version = std.process.Command(a, setting("SUN_EXECUTABLE", "sun"));
    version.add_arg("--version");
    var output = try version.output();
    var path = String("build/sun-version.txt");
    var text = output.stdout().clone(a);
    text.append(output.stderr());
    try std.io.write_string(path, text);
    if (mode.equals_literal("--plot-test")) {
      return test("plot-tests");
    }
    if (mode.equals_literal("--test")) {
      return test("tline-tests");
    }
    if (not mode.equals_literal("--build") and not mode.equals_literal("--all") and
      not mode.equals_literal("--self-test")) {
      return SystemResult.Error(
        Error(1, "Usage: ./build.sh [--all|--build|--test|--plot-test|--self-test]")
      );
    }
    try compile("sun_tline", true);
    if (mode.equals_literal("--all")) {
      try test("tline-tests");
      try test("plot-tests");
    }
    if (mode.equals_literal("--all") or mode.equals_literal("--self-test")) {
      var target = try build_targets.load("sun_tline");
      var command = std.process.Command(a, target.output);
      command.add_arg("--self-test");
      try run(command);
    }
    return SystemResult.Ok;
  }
}

/** Runs build orchestration without importing graphical dependencies. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  var mode = String("--all");
  if (args.size() == 2) {
    mode = args[1].clone(a);
  }
  return match build_tasks.execute(mode) {
    SystemResult.Ok => 0,
    SystemResult.Error(error) => {
      eprintln(error.message());
      return 1;
    }
  };
}
manifest {
  libraries: [
    "stdlib.moon"
  ], source_files: [
    "targets.sun"
  ]
}
