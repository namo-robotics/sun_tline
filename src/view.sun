using std;

/** Describes controls and translates semantic events into application operations. */
public module controls {

  /** Appends a layout container and returns its parent index. */
  function box(view: ref ui.View, parent: i64, key: i64, kind: ui.Kind) i64 {
    var e = ui.Element(ui.Key(key), kind);
    e.spacing = 8;
    e.expand_x = true;
    if (key == 1000 or key == 1003) {
      e.expand_y = true;
    }
    if (key == 1000) {
      e.margin = 12;
    }
    return view.append(parent, e);
  }

  /** Appends a text label. */
  function label(view: ref ui.View, parent: i64, key: i64, text: String) void {
    var e = ui.Element(ui.Key(key), ui.Kind.Label);
    e.text = text;
    view.append(parent, e);
  }

  /** Appends an action button with a stable key. */
  function button(view: ref ui.View, parent: i64, key: i64, text: String) void {
    var e = ui.Element(ui.Key(key), ui.Kind.Button);
    e.text = text;
    e.action = key;
    view.append(parent, e);
  }

  /** Appends a controlled selector using numeric option keys. */
  function select(view: ref ui.View, parent: i64, key: i64, selected: i64, count: i64) void {
    var e = ui.Element(ui.Key(key), ui.Kind.Select);
    e.selected = selected;
    e.action = key;
    for (var i: i64 = 0; i < count; i += 1) {
      var name = app.preset_name(i);
      if (key == 20) {
        name = app.load_name(i);
      } else if (key == 21) {
        name = app.wave_name(i);
      }
      e.choices.push(ui.Choice(ui.Key(i), name));
    }
    view.append(parent, e);
  }

  /** Names each editable SI-valued physical field. */
  function field_name(index: i64) String {
    if (index == 0) {
      return String("Source amplitude (V)");
    }
    if (index == 1) {
      return String("Source resistance (ohm)");
    }
    if (index == 2) {
      return String("Line impedance (ohm)");
    }
    if (index == 3) {
      return String("Length (m)");
    }
    if (index == 4) {
      return String("Propagation speed (m/s)");
    }
    if (index == 5) {
      return String("Load resistance (ohm)");
    }
    if (index == 6) {
      return String("Load capacitance (F)");
    }
    if (index == 7) {
      return String("Load inductance (H)");
    }
    if (index == 8) {
      return String("Pulse width (s)");
    }
    if (index == 9) {
      return String("Sine frequency (Hz)");
    }
    return String("Line cells (32–16384)");
  }

  /** Creates the complete single-window view from borrowed application state. */
  public function view(state: const ref app.State) ui.View {
    var a = make_heap_allocator();
    var v = ui.View(a);
    var root = box(v, -1, 1000, ui.Kind.Column);
    var toolbar = box(v, root, 1001, ui.Kind.Row);
    button(v, toolbar, 1, String(state.running ? "Pause" : "Run"));
    button(v, toolbar, 2, String("Reset"));
    button(v, toolbar, 3, String("Single step"));
    button(v, toolbar, 4, String("Rescale"));
    button(v, toolbar, 5, String("Slower"));
    button(v, toolbar, 6, String("Faster"));
    label(v, toolbar, 1002, `${state.speed} transit/s`);
    var check = ui.Element(ui.Key(7), ui.Kind.Checkbox);
    check.text = String("Traveling components");
    check.checked = state.components;
    check.action = 7;
    v.append(toolbar, check);
    var body = box(v, root, 1003, ui.Kind.Row);
    var scroll = ui.Element(ui.Key(1004), ui.Kind.Scroll);
    scroll.width = 285;
    scroll.expand_y = true;
    var side = box(v, v.append(body, scroll), 1005, ui.Kind.Column);
    label(v, side, 1006, String("EXPERIMENT"));
    select(v, side, 22, state.preset_index, 8);
    label(v, side, 1007, String("Load circuit"));
    select(v, side, 20, state.load_index, 8);
    label(v, side, 1008, String("Source waveform"));
    select(v, side, 21, state.wave_index, 3);
    for (var i: i64 = 0; i < state.fields.size(); i += 1) {
      if (state.field_visible(i)) {
        label(v, side, 200 + i, field_name(i));
        var input = ui.Element(ui.Key(100 + i), ui.Kind.TextInput);
        input.text = state.fields[i].clone(a);
        input.action = 100 + i;
        v.append(side, input);
      }
    }
    button(v, side, 8, String("Apply and reset"));
    var drawing = ui.Element(ui.Key(30), ui.Kind.Drawing);
    drawing.drawing_id = 1;
    drawing.expand_x = true;
    drawing.expand_y = true;
    drawing.min_width = 660;
    drawing.min_height = 490;
    v.append(body, drawing);
    label(
      v,
      root,
      1009,
      `t = ${state.simulation.time() * 1e9} ns     transit = ${state.simulation.config.transit() * 1e9} ns     step = ${state.simulation.steps}`
    );
    label(v, root, 1010, state.message.clone(a));
    label(
      v,
      root,
      1011,
      String(
        "Ideal lossless line: resistance absorbs energy; undamped circuits may keep oscillating. Sine drive remains periodic."
      )
    );
    return v;
  }

  /** Applies one user action; invalid draft edits remain visible for correction. */
  public function handle(
    state: ref app.State,
    event: const ref ui.Event,
    queue: ref ui.EventQueue
  ) SystemResult<void> {
    var a = make_heap_allocator();
    state.revision += 1;
    if (event.action >= 100 and event.action <= 110) {
      ignore_error(state.fields.set(event.action - 100, event.value.text.clone(a)));
    } else if (event.action >= 20 and event.action <= 22) {
      for (var i: i64 = 0; i < 8; i += 1) {
        var key = ui.Key(i);
        if (event.value.selection.equals(key)) {
          if (event.action == 20) {
            state.load_index = i;
          }
          if (event.action == 21 and i < 3) {
            state.wave_index = i;
          }
          if (event.action == 22) {
            try state.preset(i);
          }
        }
      }
    } else if (event.action == 1) {
      state.running = not state.running;
      state.message = String(
        state.running ? "Running — physical time is slowed for visualization." : "Paused."
      );
    } else if (event.action == 2) {
      state.reset();
    } else if (event.action == 3) {
      state.running = false;
      state.advance(1);
    } else if (event.action == 4) {
      state.rescale();
    } else if (event.action == 5) {
      state.speed *= 0.5;
      if (state.speed < 0.0625) {
        state.speed = 0.0625;
      }
    } else if (event.action == 6) {
      state.speed *= 2.0;
      if (state.speed > 8.0) {
        state.speed = 8.0;
      }
    } else if (event.action == 7) {
      state.components = event.value.boolean;
    } else if (event.action == 8) {
      state.apply();
    }
    return SystemResult.Ok;
  }
}
